# ---------------------------------------------------------------------------
# MedCore environment configuration
# Copy this file to ".env" and adjust the values for your environment.
# Never commit the real .env file.
# ---------------------------------------------------------------------------

APP_NAME="MedCore Platform"
APP_BRAND="Medboat"
APP_ENV=local            # local | production
APP_DEBUG=true           # MUST be false in production
APP_URL=http://localhost:8000
APP_TIMEZONE=Africa/Lagos

# --- Database ---------------------------------------------------------------
# DB_DRIVER=mysql  -> production / XAMPP default (MySQL)
# DB_DRIVER=sqlite -> zero-config local demo (used by the bundled dev server)
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=medcore_db
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4
SQLITE_PATH=storage/database/medcore.sqlite

# --- Security ---------------------------------------------------------------
# Set to true when serving over HTTPS so cookies get the Secure flag.
SESSION_SECURE_COOKIE=false
SESSION_IDLE_TIMEOUT=1800        # seconds of inactivity before logout
SESSION_ABSOLUTE_TIMEOUT=43200   # hard session lifetime in seconds

# Require users to verify their e-mail before signing in.
# Keep false while developing without a mail server.
AUTH_REQUIRE_VERIFICATION=false

# When no mailer is configured and APP_DEBUG=true, password-reset and
# verification links are shown on screen instead of being emailed.
DEV_SHOW_LINKS=true
