# Copy to config/.env and fill in. config/.env is git-ignored. Never commit real values.
# Keep STORAGE_PATH OUTSIDE the public web root (verification videos and ad media live there).

APP_ENV=production
APP_URL=https://match.example.com
# 32 random bytes, base64 encoded:  php -r "echo 'base64:'.base64_encode(random_bytes(32)), PHP_EOL;"
APP_KEY=base64:CHANGE_ME
TRUST_PROXY=0
SESSION_TTL_HOURS=168

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=codealpha_matchcom
DB_USER=codealpha_app
DB_PASS=CHANGE_ME

# Private storage (verification videos, message media, ad media, logs). Must NOT be inside public/.
STORAGE_PATH=/var/lib/codealpha/storage

# OTP delivery: "log" writes codes to the private log (development only). Use a real provider in production.
OTP_DRIVER=log
MAIL_FROM=no-reply@example.com

# Real-time calls
SIGNALLING_URL=wss://match.example.com/signal
# Must equal SIGNALLING_SECRET used by the signalling service. At least 32 characters.
SIGNALLING_SECRET=CHANGE_ME_AT_LEAST_32_CHARACTERS_LONG
STUN_URL=stun:stun.example.com:3478
TURN_URL=turn:turn.example.com:3478?transport=udp
# coturn static-auth-secret (use-auth-secret). Credentials are generated per session and expire in 1 hour.
TURN_SECRET=CHANGE_ME

# Payment gateways: API keys are NOT stored here. Enter them in the Super Admin gateway screen;
# they are encrypted in MySQL with APP_KEY. Official docs:
#   https://paystack.com/docs/   https://developer.flutterwave.com/docs
